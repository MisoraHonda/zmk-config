#include "clear_orange.dtsi"

/ {
    trackball: trackball {
        compatible = "pixart,mx8650";
        status = "okay";
        /* 回路図12ピン (SCLK_3.3V_mic) -> pro_micro 9 */
        sclk-gpios = <&pro_micro 9 GPIO_ACTIVE_HIGH>;
        /* 回路図11ピン (SDIO_3.3V_mic)  -> pro_micro 8 */
        sdio-gpios = <&pro_micro 8 GPIO_ACTIVE_HIGH>;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
    };
};

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    // ▼ 順番を Col0 ➔ Col6 の正順に戻し、最下段の空席位置も正しく修正しました
    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <4>;
        map = <
            _ _ _ _ _ _ _ RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)
            _ _ _ _ _ _ _ RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)
            _ _ _ _ _ _ _ RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)
            _ _ _ _ _ _ _ RC(3,0) RC(3,1) RC(3,2)   _     RC(3,4)   _     RC(3,6)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row"; 

        // Row側（物理7〜10ピン）のマッピング
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row0: 回路図7ピン (D4)
            , <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row1: 回路図8ピン (D5)
            , <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row2: 回路図9ピン (D6)
            , <&pro_micro 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row3: 回路図10ピン (D7)
            ;

        // Col側（物理14〜20ピン）のマッピング
        col-gpios
            = <&pro_micro 21 GPIO_ACTIVE_LOW> // Col0: 回路図20ピン (A3)
            , <&pro_micro 20 GPIO_ACTIVE_LOW> // Col1: 回路図19ピン (A2)
            , <&pro_micro 19 GPIO_ACTIVE_LOW> // Col2: 回路図18ピン (A1)
            , <&pro_micro 18 GPIO_ACTIVE_LOW> // Col3: 回路図17ピン (A0)
            , <&pro_micro 15 GPIO_ACTIVE_LOW> // Col4: 回路図16ピン (D15)
            , <&pro_micro 14 GPIO_ACTIVE_LOW> // Col5: 回路図15ピン (D14)
            , <&pro_micro 16 GPIO_ACTIVE_LOW> // Col6: 回路図14ピン (D16)
            ;
    };
};
