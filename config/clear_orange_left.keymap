#include "boards/shields/clear_orange/clear_orange.dtsi"

#include <dt-bindings/zmk/matrix_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

#define DEF 0
#define NUM 1
#define MSE 2
#define FNC 3

/ {
    keymap {
        compatible = "zmk,keymap";

        // 0: デフォルトレイヤー
        default_layer {
            bindings = <
                &kp TAB   &kp Q    &kp W    &kp E     &kp R   &kp T   &kp MINUS     &kp Y    &kp U    &kp I    &kp O     &kp P    &kp BSPC  &kp GRAVE
                &kp CAPS  &kp A    &kp S    &kp D     &kp F   &kp G   &kp EQUAL     &kp BSLH &kp H    &kp J    &kp L     &kp SEMI &kp SQT   &kp RET
                &kp LSHFT &kp Z    &kp X    &kp C     &kp V   &kp B   &kp C_MUTE    &kp B    &kp N    &kp K    &kp COMMA &kp DOT  &kp FSLH  &kp RSHFT
                &kp LCTRL &kp LGUI &kp LALT &kp GRAVE &mo NUM &mo MSE &none         &mo FNC  &none    &kp M    &none     &none    &kp ESC   &kp RCTRL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // 1: テンキーレイヤー
        tenkey_layer {
            bindings = <
                &trans    &trans   &trans   &trans    &trans  &trans  &trans        &kp KP_N7 &kp KP_N8 &kp KP_N9 &trans   &trans    &trans    &trans
                &trans    &trans   &trans   &trans    &trans  &trans  &trans        &trans    &kp KP_N4 &kp KP_N5 &kp KP_N6 &trans   &trans    &trans
                &trans    &trans   &trans   &trans    &trans  &trans  &trans        &kp KP_N0 &kp KP_N1 &kp KP_N2 &kp KP_N3 &trans   &trans    &trans
                &trans    &trans   &trans   &trans    &trans  &trans  &trans        &trans    &none     &none     &none     &none    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // 2: マウス＆矢印レイヤー
        mouse_layer {
            bindings = <
                &trans    &trans   &trans   &trans    &trans  &trans  &trans        &trans    &trans    &trans    &trans    &trans   &trans    &trans
                &trans    &trans   &trans   &trans    &trans  &trans  &trans        &trans    &trans    &trans    &trans    &trans   &trans    &trans
                &trans    &trans   &trans   &trans    &trans  &trans  &trans        &trans    &trans    &trans    &trans    &trans   &trans    &trans
                &trans    &trans   &trans   &trans    &trans  &trans  &trans        &trans    &none     &none     &none     &none    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // 3: ファンクションレイヤー
        function_layer {
            bindings = <
                &trans    &kp F1   &kp F2   &kp F3    &kp F4  &kp F5  &kp F6        &trans    &trans    &trans    &trans    &trans   &trans    &trans
                &trans    &kp F7   &kp F8   &kp F9    &kp F10 &kp F11 &kp F12       &trans    &trans    &trans    &trans    &trans   &trans    &trans
                &trans    &kp F13  &kp F14  &kp F15   &kp F16 &kp F17 &trans        &trans    &trans    &trans    &trans    &trans   &trans    &trans
                &trans    &trans   &trans   &trans    &trans  &trans  &trans        &trans    &none     &none     &none     &none    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
